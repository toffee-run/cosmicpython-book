{
  "name": "cosmicpython-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/prepare-content.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-content.mjs && vite build && node scripts/finalize-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
